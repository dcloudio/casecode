<template>
	<uni-tab style="flex: 1;height: 100%;" :active-index="activeIndex" @change="handleChange">
		<!-- 内容区域 -->
    <!-- 注意tab的逻辑是：第一次使用v-if创建，创建之后不再使用v-if，而是设置visibility来隐藏和显示。不能设置tab的v-if为false，因为销毁再创建影响性能 -->
		<view style="width: 100%;height: 100%;position: absolute;" :style="{visibility:(activeIndex==0?'visible':'hidden'),height: (tabContentHeight + 'px')}"
     > <componenttab /> </view>
		<view style="width: 100%;height: 100%;position: absolute;" :style="{visibility:(activeIndex==1?'visible':'hidden'),height: (tabContentHeight + 'px')}"
    v-if="isTabInitArray[1]" > <apitab /> </view>
		<view style="width: 100%;height: 100%;position: absolute;" :style="{visibility:(activeIndex==2?'visible':'hidden'),height: (tabContentHeight + 'px')}"
    v-if="isTabInitArray[2]" > <csstab /> </view>
		<view style="width: 100%;height: 100%;position: absolute;" :style="{visibility:(activeIndex==3?'visible':'hidden'),height: (tabContentHeight + 'px')}"
    v-if="isTabInitArray[3]" > <uniuitab /> </view>
		<view style="width: 100%;height: 100%;position: absolute;" :style="{visibility:(activeIndex==4?'visible':'hidden'),height: (tabContentHeight + 'px')}"
    v-if="isTabInitArray[4]" > <templatetab /> </view>

		<!-- 底部选项卡 -->
		<uni-tab-bar :style="{ backgroundColor: tabBarBgColor }">
			<!-- 图标高度24，文字字号10px。如需角标，在 <uni-tab-item> 上设置 badge-text="99+" -->
			<uni-tab-item>
				<image :src="activeIndex == 0 ? '/static/componentHL.png' : '/static/component.png'" class="tab-icon-image" flatten></image>
				<text class="tab-label" :class="[activeIndex == 0 ? 'tab-label-active' : '', darkTextClass]" flatten>组件</text>
			</uni-tab-item>
			<uni-tab-item>
				<image :src="activeIndex == 1 ? '/static/apiHL.png' : '/static/api.png'" class="tab-icon-image" flatten></image>
				<text class="tab-label" :class="[activeIndex == 1 ? 'tab-label-active' : '', darkTextClass]" flatten>API</text>
			</uni-tab-item>
			<uni-tab-item>
				<image :src="activeIndex == 2 ? '/static/cssHL.png' : '/static/css.png'" class="tab-icon-image" flatten></image>
				<text class="tab-label" :class="[activeIndex == 2 ? 'tab-label-active' : '', darkTextClass]" flatten>CSS</text>
			</uni-tab-item>
			<uni-tab-item>
				<image :src="activeIndex == 3 ? '/static/extuiHL.png' : '/static/extui.png'" class="tab-icon-image" flatten></image>
				<text class="tab-label" :class="[activeIndex == 3 ? 'tab-label-active' : '', darkTextClass]" flatten>uni-ui</text>
			</uni-tab-item>
			<uni-tab-item>
				<image :src="activeIndex == 4 ? '/static/templateHL.png' : '/static/template.png'" class="tab-icon-image" flatten></image>
				<text class="tab-label" :class="[activeIndex == 4 ? 'tab-label-active' : '', darkTextClass]" flatten>模板</text>
			</uni-tab-item>
		</uni-tab-bar>
	</uni-tab>
</template>

<script setup lang="uts">
	import componenttab from './component.uvue'
	import apitab from './API.uvue'
	import csstab from './CSS.uvue'
	import templatetab from './template.uvue'
	import uniuitab from './uni-ui.uvue'
	import { state } from '@/store/index.uts'

	const windowInfo = uni.getWindowInfo()
	// tab内容区域高度 = 窗口高度 - tab-bar高度(50) - 底部安全区
	const tabContentHeight = ref<number>(windowInfo.windowHeight - 50 - (windowInfo.safeAreaInsets.bottom))
	const activeIndex = ref<number>(0)
	// 记录每个tab是否初始化过，未激活过的tab先不创建，等首次激活再创建
	let isTabInitArray = ref<boolean[]>([true, false, false, false, false])

	const darkTextClass = computed((): string => {
		return state.isDarkMode ? 'tab-label-dark' : ''
	})

	const tabBarBgColor = computed((): string => {
		return state.isDarkMode ? '#1F1F1F' : '#F8F8F8'
	})

	// uni-tab-item 点击后由 <uni-tab> 抛出 change 事件，携带新激活的索引
	function handleChange(index : number) : void {
		activeIndex.value = index
		switch (index) {
			case 0:
				uni.setNavigationBarTitle({ title: '组件' })
				break
			case 1:
				uni.setNavigationBarTitle({ title: 'API' })
				isTabInitArray.value[1] = true
				break
			case 2:
				uni.setNavigationBarTitle({ title: 'CSS' })
				isTabInitArray.value[2] = true
				break
			case 3:
				uni.setNavigationBarTitle({ title: 'uni-ui' })
				isTabInitArray.value[3] = true
				break
			case 4:
				uni.setNavigationBarTitle({ title: '模板' })
				isTabInitArray.value[4] = true
				break
		}
	}
</script>

<style>

	.tab-icon-image {
		height: 24px;
		width: 24px;
	}

	.tab-label {
		font-size: 10px;
    color: rgb(122, 126, 131);
	}

	.tab-label-dark {
		color: #CACACA;
	}

	.tab-label-active {
		color: #007aff;
	}
</style>
