<template>
  <view id="editor-page-shell" :class="getPageShellClass()">
    <view id="editor-layout" :class="getEditorLayoutClass()">
    <view
      class="toolbar-wrap"
      :class="isWebToolbarMode() ? 'toolbar-wrap toolbar-wrap-web' : 'toolbar-wrap toolbar-wrap-mobile'"
      :style="getToolbarWrapStyle()"
     v-if="isToolbarRendered()"
      @touchstart="onToolbarTouchStart"
      <!--#ifdef WEB -->
      @mousedown="onToolbarMouseDown"
      <!--#endif-->
    >
      <!-- #ifdef WEB -->
      <view v-if="isWebToolbarMode()" class="desktop-toolbar-wrap">
        <view :class="getDesktopToolbarShellClass()" @mousemove="hideToolbarTooltip">
          <view :class="getDesktopToolbarGroupClass()">
            <view id="toolbar-button-undo" @click="undo" @mousemove.stop="showToolbarTooltip('toolbar-button-undo', '撤回')" class="toolbar-web-icon-button">
              <text class="toolbar-web-icon-text iconfont">{{"&#xe6a3;"}}</text>
            </view>
            <view id="toolbar-button-redo" @click="redo" @mousemove.stop="showToolbarTooltip('toolbar-button-redo', '重做')" class="toolbar-web-icon-button">
              <text class="toolbar-web-icon-text iconfont">{{"&#xe6a5;"}}</text>
            </view>
            <view id="toolbar-button-clear-format" @click="clearFormatting" @mousemove.stop="showToolbarTooltip('toolbar-button-clear-format', '清除格式')" class="toolbar-web-icon-button">
              <text class="toolbar-web-icon-text iconfont">{{"&#xe6b9;"}}</text>
            </view>
          </view>

          <view :class="getDesktopToolbarDividerClass()"></view>

          <view :class="getDesktopToolbarGroupClass(false)">
            <view id="toolbar-button-font-size" @click="openFontSizeSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-font-size', '设置字号')" :class="isFontSizeSheetHighlighted() ? 'toolbar-web-select toolbar-web-select-active' : 'toolbar-web-select'">
              <text :class="isFontSizeSheetHighlighted() ? 'toolbar-web-select-label toolbar-web-select-label-active toolbar-web-size-label' : 'toolbar-web-select-label toolbar-web-size-label'">{{ getDesktopFontSizeLabel() }}</text>
              <text :class="isFontSizeSheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-font-family" @click="openFontFamilySheet" @mousemove.stop="showToolbarTooltip('toolbar-button-font-family', '设置字体')" :class="isFontFamilySheetHighlighted() ? 'toolbar-web-select toolbar-web-select-font toolbar-web-select-active' : 'toolbar-web-select toolbar-web-select-font'">
              <!-- <text :class="isFontFamilySheetHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-select-glyph iconfont' : 'toolbar-web-icon-text toolbar-web-select-glyph iconfont'">{{"&#xe68e;"}}</text> -->
              <text :class="isFontFamilySheetHighlighted() ? 'toolbar-web-select-label toolbar-web-select-label-active toolbar-web-select-font-label' : 'toolbar-web-select-label toolbar-web-select-font-label'">{{ getDesktopFontFamilyLabel() }}</text>
              <text :class="isFontFamilySheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-bold" @click="toggleBold" @mousemove.stop="showToolbarTooltip('toolbar-button-bold', '加粗')" :class="data.formats.bold ? 'toolbar-web-icon-button toolbar-web-icon-button-active' : 'toolbar-web-icon-button'">
              <text :class="data.formats.bold ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-font-action iconfont relative-top-1' : 'toolbar-web-icon-text toolbar-web-font-action iconfont relative-top-1'">{{"&#xe6ae;"}}</text>
            </view>
            <view id="toolbar-button-italic" @click="toggleItalic" @mousemove.stop="showToolbarTooltip('toolbar-button-italic', '斜体')" :class="data.formats.italic ? 'toolbar-web-icon-button toolbar-web-icon-button-active' : 'toolbar-web-icon-button'">
              <text :class="data.formats.italic ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-font-action iconfont relative-top-1' : 'toolbar-web-icon-text toolbar-web-font-action iconfont relative-top-1'">{{"&#xe6af;"}}</text>
            </view>
            <view id="toolbar-button-underline" @click="toggleUnderline" @mousemove.stop="showToolbarTooltip('toolbar-button-underline', '下划线')" :class="data.formats.underline ? 'toolbar-web-icon-button toolbar-web-icon-button-active' : 'toolbar-web-icon-button'">
              <text :class="data.formats.underline ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-font-action iconfont' : 'toolbar-web-icon-text toolbar-web-font-action iconfont'">{{"&#xe6a7;"}}</text>
            </view>
            <view id="toolbar-button-strike" @click="toggleStrike" @mousemove.stop="showToolbarTooltip('toolbar-button-strike', '删除线')" :class="data.formats.strike ? 'toolbar-web-icon-button toolbar-web-icon-button-active' : 'toolbar-web-icon-button'">
              <text :class="data.formats.strike ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-font-action iconfont relative-top-1' : 'toolbar-web-icon-text toolbar-web-font-action iconfont relative-top-1'">{{"&#xe6aa;"}}</text>
            </view>
          </view>

          <view :class="getDesktopToolbarDividerClass()"></view>

          <view :class="getDesktopToolbarGroupClass(false)">
            <view id="toolbar-button-text-color" @click="openTextColorSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-text-color', '字体颜色')" :class="isTextColorSheetHighlighted() ? 'toolbar-web-color-button toolbar-web-color-button-active' : 'toolbar-web-color-button'">
              <view class="toolbar-web-color-stack">
                <text :class="isTextColorSheetHighlighted() ? 'toolbar-web-color-symbol toolbar-web-color-symbol-active iconfont' : 'toolbar-web-color-symbol iconfont'">{{"&#xe6b8;"}}</text>
                <view class="toolbar-web-color-underline" :style="getToolbarTextColorChipStyle()"></view>
              </view>
              <text :class="isTextColorSheetHighlighted() ? 'toolbar-web-color-arrow toolbar-web-color-arrow-active iconfont' : 'toolbar-web-color-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-background-color" @click="openBackgroundColorSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-background-color', '背景颜色')" :class="isBackgroundColorSheetHighlighted() ? 'toolbar-web-color-button toolbar-web-color-button-active' : 'toolbar-web-color-button'">
              <view class="toolbar-web-color-stack">
                <text :class="isBackgroundColorSheetHighlighted() ? 'toolbar-web-color-symbol toolbar-web-color-symbol-active iconfont' : 'toolbar-web-color-symbol iconfont'">{{"&#xe6bb;"}}</text>
                <view class="toolbar-web-color-underline" :style="getToolbarBackgroundColorChipStyle()"></view>
              </view>
              <text :class="isBackgroundColorSheetHighlighted() ? 'toolbar-web-color-arrow toolbar-web-color-arrow-active iconfont' : 'toolbar-web-color-arrow iconfont'" style="margin-left: 2px">{{"&#xe6be;"}}</text>
            </view>
          </view>
          <view :class="getDesktopToolbarDividerClass()"></view>

          <view :class="getDesktopToolbarGroupClass(false)">
            <view id="toolbar-button-align" @click="openAlignSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-align', '对齐方式')" :class="isAlignSheetHighlighted() ? 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-active' : 'toolbar-web-select toolbar-web-select-compact'">
              <text :class="isAlignSheetHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-select-glyph iconfont' : 'toolbar-web-icon-text toolbar-web-select-glyph iconfont'" v-html="getDesktopAlignIconGlyph()"></text>
              <text :class="isAlignSheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-text-indent" @click="toggleTextIndent" @mousemove.stop="showToolbarTooltip('toolbar-button-text-indent', '首行缩进')" :class="isTextIndentHighlighted() ? 'toolbar-web-icon-button toolbar-web-icon-button-active' : 'toolbar-web-icon-button'">
              <text :class="isTextIndentHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active iconfont' : 'toolbar-web-icon-text iconfont'">{{"&#xe6ad;"}}</text>
            </view>
            <view id="toolbar-button-block-indent" @click="openBlockIndentSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-block-indent', '两端缩进')" :class="isBlockIndentSheetHighlighted() ? 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-active' : 'toolbar-web-select toolbar-web-select-compact'">
              <text :class="isBlockIndentSheetHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-select-glyph iconfont' : 'toolbar-web-icon-text toolbar-web-select-glyph iconfont'">{{"&#xe6ba;"}}</text>
              <text :class="isBlockIndentSheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-line-height" @click="openLineHeightSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-line-height', '行间距')" :class="isLineHeightSheetHighlighted() ? 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-value toolbar-web-select-active' : 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-value'">
              <text :class="isLineHeightSheetHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-select-glyph iconfont' : 'toolbar-web-icon-text toolbar-web-select-glyph iconfont'">{{"&#xe6b0;"}}</text>
              <text :class="isLineHeightSheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-letter-spacing" @click="openLetterSpacingSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-letter-spacing', '字间距')" :class="isLetterSpacingSheetHighlighted() ? 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-value toolbar-web-select-active' : 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-value'">
              <text :class="isLetterSpacingSheetHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-select-glyph iconfont' : 'toolbar-web-icon-text toolbar-web-select-glyph iconfont'">{{"&#xe6ac;"}}</text>
              <text :class="isLetterSpacingSheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-list" @click="openListSheet" @mousemove.stop="showToolbarTooltip('toolbar-button-list', '列表')" :class="isListSheetHighlighted() ? 'toolbar-web-select toolbar-web-select-compact toolbar-web-select-active' : 'toolbar-web-select toolbar-web-select-compact'">
              <text :class="isListSheetHighlighted() ? 'toolbar-web-icon-text toolbar-web-icon-text-active toolbar-web-select-glyph iconfont' : 'toolbar-web-icon-text toolbar-web-select-glyph iconfont'">{{"&#xe6a4;"}}</text>
              <text :class="isListSheetHighlighted() ? 'toolbar-web-select-arrow toolbar-web-select-arrow-active iconfont' : 'toolbar-web-select-arrow iconfont'">{{"&#xe6be;"}}</text>
            </view>
            <view id="toolbar-button-divider" @click="insertDivider" @mousemove.stop="showToolbarTooltip('toolbar-button-divider', '分割线')" class="toolbar-web-icon-button">
              <text class="toolbar-web-icon-text iconfont">{{"&#xe6b4;"}}</text>
            </view>
          </view>

          <view :class="getDesktopToolbarDividerClass()"></view>

          <view :class="getDesktopToolbarGroupClass(false)">
            <view id="toolbar-button-image" @click="chooseInsertImage" @mousemove.stop="showToolbarTooltip('toolbar-button-image', '图片')" class="toolbar-web-icon-button">
              <text class="toolbar-web-icon-text iconfont">{{"&#xe6bc;"}}</text>
            </view>
          </view>
        </view>
        <view v-if="data.tooltipVisible" class="toolbar-web-tooltip" :style="getToolbarTooltipStyle()">
          <view class="toolbar-web-tooltip-arrow"></view>
          <view class="toolbar-web-tooltip-bubble">
            <text class="toolbar-web-tooltip-text">{{ data.tooltipText }}</text>
          </view>
        </view>
        <view v-if="!data.isFocused && data.activeSheet == ''" class="desktop-toolbar-mask"></view>
      </view>
      <!-- #endif -->

      <!-- #ifndef WEB -->
      <view class="mobile-toolbar-wrap">
      <view :class="getToolbarShellClass()">
        <scroll-view :class="getToolbarScrollTrackClass()" direction="horizontal" :show-scrollbar="false">
          <view :class="getToolbarRowClass()">
            <view class="toolbar-group toolbar-group-main">
              <view id="toolbar-button-more" @click="openMoreSheet" :class="data.activeSheet == 'more' ? 'toolbar-button toolbar-button-active toolbar-button-right' : 'toolbar-button toolbar-button-right'">
                <text :class="data.activeSheet == 'more' ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">{{"&#xe6bf;"}}</text>
              </view>
            </view>

            <view class="toolbar-divider toolbar-divider-side"></view>

            <view class="toolbar-group toolbar-group-main">
              <view id="toolbar-button-title" @click="openTitleSheet" :class="isTitleSheetHighlighted() ? 'toolbar-button toolbar-button-active' : 'toolbar-button'">
                <text :class="isTitleSheetHighlighted() ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">{{"&#xe67b;"}}</text>
              </view>
              <view id="toolbar-button-style" @click="openStyleSheet" :class="getMobileStyleButtonClass()">
                <text :class="isStyleSheetHighlighted() ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">{{"&#xe6b8;"}}</text>
              </view>
              <view id="toolbar-button-align" @click="openAlignSheet" :class="isAlignSheetHighlighted() ? 'toolbar-button toolbar-button-active toolbar-button-right' : 'toolbar-button toolbar-button-right'">
                <text :class="isAlignSheetHighlighted() ? 'toolbar-iconfont toolbar-iconfont-active iconfont' : 'toolbar-iconfont iconfont'">{{"&#xe6a8;"}}</text>
              </view>
            </view>

            <view class="toolbar-divider toolbar-divider-side"></view>

            <view class="toolbar-group toolbar-group-main">
              <view @click="chooseInsertImage" class="toolbar-button">
                <text class="toolbar-iconfont iconfont">{{"&#xe6bc;"}}</text>
              </view>
            </view>
          </view>
        </scroll-view>

        <!-- #ifndef WEB -->
        <view class="toolbar-fixed-action">
          <view class="toolbar-fixed-inner">
            <view class="toolbar-divider toolbar-divider-fixed"></view>
            <view @click="hideEditorKeyboard" class="toolbar-button toolbar-button-dismiss">
              <text class="toolbar-iconfont iconfont hide-keyboard">{{"&#xe69a;"}}</text>
            </view>
          </view>
        </view>
        <!-- #endif -->
      </view>
      </view>
      <!-- #endif -->
    </view>

    <!-- #ifdef WEB -->
    <view v-if="data.activeSheet != ''" class="sheet-backdrop-web" @click="closeSheets"></view>
    <!-- #endif -->

    <view
     id="editor-sheet-host"
     class="sheet-host"
     :class="isWebToolbarMode() ? 'sheet-host sheet-host-web' : 'sheet-host'"
     :style="getSheetHostStyle()"
     v-if="data.activeSheet != ''"
      @touchstart="onToolbarTouchStart"
      <!--#ifdef WEB -->
      @mousedown="onToolbarMouseDown"
      <!--#endif-->
    >
      <view :class="getToolbarPanelClass()" :style="getSheetPanelStyle()">
        <!-- #ifdef WEB -->
        <view class="toolbar-panel-arrow" :style="getToolbarPanelArrowStyle()"></view>
        <!-- #endif -->
        <view :class="getToolbarPanelHeaderClass()">
          <view class="toolbar-panel-title-wrap">
            <text :class="getToolbarPanelTitleClass()">{{ getPanelTitle() }}</text>
            <text :class="getToolbarPanelSubtitleClass()">{{ getPanelSubtitle() }}</text>
          </view>
        </view>

        <scroll-view :class="getToolbarPanelScrollClass()" direction="vertical" :show-scrollbar="false">
          <view class="toolbar-panel-section" v-if="data.activeSheet == 'title'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="setParagraph" :class="getDesktopMenuItemClass(isParagraphActive())"><text :class="getDesktopMenuBadgeClass(isParagraphActive())">P</text><text :class="getDesktopMenuTextClass(isParagraphActive())">正文</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(1)" :class="getDesktopMenuItemClass(data.formats.header == 1)"><text :class="getDesktopMenuBadgeClass(data.formats.header == 1)">H1</text><text :class="getDesktopMenuTextClass(data.formats.header == 1)">大标题1</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(2)" :class="getDesktopMenuItemClass(data.formats.header == 2)"><text :class="getDesktopMenuBadgeClass(data.formats.header == 2)">H2</text><text :class="getDesktopMenuTextClass(data.formats.header == 2)">大标题2</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(3)" :class="getDesktopMenuItemClass(data.formats.header == 3)"><text :class="getDesktopMenuBadgeClass(data.formats.header == 3)">H3</text><text :class="getDesktopMenuTextClass(data.formats.header == 3)">大标题3</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(4)" :class="getDesktopMenuItemClass(data.formats.header == 4)"><text :class="getDesktopMenuBadgeClass(data.formats.header == 4)">H4</text><text :class="getDesktopMenuTextClass(data.formats.header == 4)">大标题4</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(5)" :class="getDesktopMenuItemClass(data.formats.header == 5)"><text :class="getDesktopMenuBadgeClass(data.formats.header == 5)">H5</text><text :class="getDesktopMenuTextClass(data.formats.header == 5)">大标题5</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setHeadingLevel(6)" :class="getDesktopMenuItemClass(data.formats.header == 6)"><text :class="getDesktopMenuBadgeClass(data.formats.header == 6)">H6</text><text :class="getDesktopMenuTextClass(data.formats.header == 6)">大标题6</text></view></view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'style'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="toggleBoldAndClose" :class="getDesktopMenuItemClass(data.formats.bold)"><text :class="getDesktopMenuBadgeClass(data.formats.bold)">B</text><text :class="getDesktopMenuTextClass(data.formats.bold)">加粗</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="toggleItalicAndClose" :class="getDesktopMenuItemClass(data.formats.italic)"><text :class="getDesktopMenuBadgeClass(data.formats.italic)">I</text><text :class="getDesktopMenuTextClass(data.formats.italic)">斜体</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="toggleUnderlineAndClose" :class="getDesktopMenuItemClass(data.formats.underline)"><text :class="getDesktopMenuBadgeClass(data.formats.underline)">U</text><text :class="getDesktopMenuTextClass(data.formats.underline)">下划线</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="toggleStrikeAndClose" :class="getDesktopMenuItemClass(data.formats.strike)"><text :class="getDesktopMenuBadgeClass(data.formats.strike)">S</text><text :class="getDesktopMenuTextClass(data.formats.strike)">删除线</text></view></view>
            </view>

            <view class="toolbar-color-section">
              <text class="toolbar-color-title">文字颜色</text>
              <view :class="getColorRowClass()">
                <view @click="setTextColorAndClose('')" :class="getClearColorSwatchClass(data.formats.color == '')"></view>
                <view v-for="color in TEXT_COLOR_PRESETS" :key="color" @click="setTextColorAndClose(color)" :class="getFilledColorSwatchClass(data.formats.color == color)" :style="'background-color: ' + color + ';'"></view>
              </view>
            </view>

            <view class="toolbar-color-section">
              <text class="toolbar-color-title">背景颜色</text>
              <view :class="getColorRowClass()">
                <view @click="setBackgroundColorAndClose('')" :class="getClearColorSwatchClass(data.formats.backgroundColor == '')"></view>
                <view v-for="color in BACKGROUND_COLOR_PRESETS" :key="color" @click="setBackgroundColorAndClose(color)" :class="getFilledColorSwatchClass(data.formats.backgroundColor == color)" :style="'background-color: ' + color + ';'"></view>
              </view>
            </view>

          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'line-height'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">行间距</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="setLineHeightAndClose('')" :class="getDesktopMenuItemClass(data.formats.lineHeight == '')"><text :class="getDesktopMenuBadgeClass(data.formats.lineHeight == '')">A</text><text :class="getDesktopMenuTextClass(data.formats.lineHeight == '')">默认</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setLineHeightAndClose('1.5')" :class="getDesktopMenuItemClass(data.formats.lineHeight == '1.5')"><text :class="getDesktopMenuBadgeClass(data.formats.lineHeight == '1.5')">1.5</text><text :class="getDesktopMenuTextClass(data.formats.lineHeight == '1.5')">紧凑</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setLineHeightAndClose('1.8')" :class="getDesktopMenuItemClass(data.formats.lineHeight == '1.8')"><text :class="getDesktopMenuBadgeClass(data.formats.lineHeight == '1.8')">1.8</text><text :class="getDesktopMenuTextClass(data.formats.lineHeight == '1.8')">舒适</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setLineHeightAndClose('2')" :class="getDesktopMenuItemClass(data.formats.lineHeight == '2')"><text :class="getDesktopMenuBadgeClass(data.formats.lineHeight == '2')">2.0</text><text :class="getDesktopMenuTextClass(data.formats.lineHeight == '2')">宽松</text></view></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'letter-spacing'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">字间距</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="setLetterSpacingAndClose('')" :class="getDesktopMenuItemClass(data.formats.letterSpacing == '')"><text :class="getDesktopMenuBadgeClass(data.formats.letterSpacing == '')">Aa</text><text :class="getDesktopMenuTextClass(data.formats.letterSpacing == '')">默认</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setLetterSpacingAndClose('0px')" :class="getDesktopMenuItemClass(data.formats.letterSpacing == '0px')"><text :class="getDesktopMenuBadgeClass(data.formats.letterSpacing == '0px')">0</text><text :class="getDesktopMenuTextClass(data.formats.letterSpacing == '0px')">标准</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setLetterSpacingAndClose('1px')" :class="getDesktopMenuItemClass(data.formats.letterSpacing == '1px')"><text :class="getDesktopMenuBadgeClass(data.formats.letterSpacing == '1px')">+1</text><text :class="getDesktopMenuTextClass(data.formats.letterSpacing == '1px')">微松</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setLetterSpacingAndClose('2px')" :class="getDesktopMenuItemClass(data.formats.letterSpacing == '2px')"><text :class="getDesktopMenuBadgeClass(data.formats.letterSpacing == '2px')">+2</text><text :class="getDesktopMenuTextClass(data.formats.letterSpacing == '2px')">通透</text></view></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'font-size'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">字号</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('12px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '12px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '12px')">12</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '12px')">12px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('14px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '14px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '14px')">14</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '14px')">14px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('15px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '15px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '15px')">15</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '15px')">15px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('16px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '16px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '16px')">16</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '16px')">16px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('17px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '17px' || data.formats.fontSize == '')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '17px' || data.formats.fontSize == '')">17</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '17px' || data.formats.fontSize == '')">默认</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('19px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '19px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '19px')">19</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '19px')">19px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('20px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '20px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '20px')">20</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '20px')">20px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('24px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '24px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '24px')">24</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '24px')">24px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('32px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '32px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '32px')">32</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '32px')">32px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontSizeAndClose('48px')" :class="getDesktopMenuItemClass(data.formats.fontSize == '48px')"><text :class="getDesktopMenuBadgeClass(data.formats.fontSize == '48px')">48</text><text :class="getDesktopMenuTextClass(data.formats.fontSize == '48px')">48px</text></view></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'font-family'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">字体</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('')" :class="getDesktopMenuItemClass(data.formats.fontFamily == '')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == '')">D</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == '')">默认</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('Microsoft YaHei')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'Microsoft YaHei')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'Microsoft YaHei')">雅黑</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'Microsoft YaHei')">微软雅黑</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('SimHei')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'SimHei')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'SimHei')">黑</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'SimHei')">黑体</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('SimSun')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'SimSun')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'SimSun')">宋</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'SimSun')">宋体</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('KaiTi')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'KaiTi')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'KaiTi')">楷</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'KaiTi')">楷体</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('FangSong')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'FangSong')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'FangSong')">仿宋</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'FangSong')">仿宋</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('Georgia')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'Georgia')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'Georgia')">Geo</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'Georgia')">Georgia</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('Times New Roman')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'Times New Roman')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'Times New Roman')">TNR</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'Times New Roman')">Times</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setFontFamilyAndClose('Courier New')" :class="getDesktopMenuItemClass(data.formats.fontFamily == 'Courier New')"><text :class="getDesktopMenuBadgeClass(data.formats.fontFamily == 'Courier New')">Mono</text><text :class="getDesktopMenuTextClass(data.formats.fontFamily == 'Courier New')">Courier</text></view></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'align'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="clearAlign" :class="getDesktopMenuItemClass(data.formats.align == '')"><text :class="getDesktopMenuBadgeClass(data.formats.align == '')">D</text><text :class="getDesktopMenuTextClass(data.formats.align == '')">默认</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignLeft" :class="getDesktopMenuItemClass(data.formats.align == 'left')"><text :class="getDesktopMenuBadgeClass(data.formats.align == 'left')">L</text><text :class="getDesktopMenuTextClass(data.formats.align == 'left')">居左</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignCenter" :class="getDesktopMenuItemClass(data.formats.align == 'center')"><text :class="getDesktopMenuBadgeClass(data.formats.align == 'center')">C</text><text :class="getDesktopMenuTextClass(data.formats.align == 'center')">居中</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignRight" :class="getDesktopMenuItemClass(data.formats.align == 'right')"><text :class="getDesktopMenuBadgeClass(data.formats.align == 'right')">R</text><text :class="getDesktopMenuTextClass(data.formats.align == 'right')">居右</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setAlignJustify" :class="getDesktopMenuItemClass(data.formats.align == 'justify')"><text :class="getDesktopMenuBadgeClass(data.formats.align == 'justify')">J</text><text :class="getDesktopMenuTextClass(data.formats.align == 'justify')">两端</text></view></view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'block-indent'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">两端缩进</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('0px')" :class="getDesktopMenuItemClass(isBlockIndentValue('0px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('0px'))">0</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('0px'))">0px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('8px')" :class="getDesktopMenuItemClass(isBlockIndentValue('8px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('8px'))">8</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('8px'))">8px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('16px')" :class="getDesktopMenuItemClass(isBlockIndentValue('16px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('16px'))">16</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('16px'))">16px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('24px')" :class="getDesktopMenuItemClass(isBlockIndentValue('24px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('24px'))">24</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('24px'))">24px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('32px')" :class="getDesktopMenuItemClass(isBlockIndentValue('32px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('32px'))">32</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('32px'))">32px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('40px')" :class="getDesktopMenuItemClass(isBlockIndentValue('40px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('40px'))">40</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('40px'))">40px</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="setBlockIndentAndClose('48px')" :class="getDesktopMenuItemClass(isBlockIndentValue('48px'))"><text :class="getDesktopMenuBadgeClass(isBlockIndentValue('48px'))">48</text><text :class="getDesktopMenuTextClass(isBlockIndentValue('48px'))">48px</text></view></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'list'">
            <view :class="getToolbarChipRowClass()">
              <view :class="getToolbarChipCellClass()"><view @click="clearListFormat" :class="getDesktopMenuItemClass(data.formats.list == '')"><text :class="getDesktopMenuBadgeClass(data.formats.list == '')">D</text><text :class="getDesktopMenuTextClass(data.formats.list == '')">默认</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setBulletList" :class="getDesktopMenuItemClass(data.formats.list == 'bullet')"><text :class="getDesktopMenuBadgeClass(data.formats.list == 'bullet')">•</text><text :class="getDesktopMenuTextClass(data.formats.list == 'bullet')">无序列表</text></view></view>
              <view :class="getToolbarChipCellClass()"><view @click="setOrderedList" :class="getDesktopMenuItemClass(data.formats.list == 'ordered')"><text :class="getDesktopMenuBadgeClass(data.formats.list == 'ordered')">1.</text><text :class="getDesktopMenuTextClass(data.formats.list == 'ordered')">有序列表</text></view></view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'text-color'">
            <view class="toolbar-color-section">
              <view class="desktop-color-sheet-label">
                <view class="desktop-color-sheet-icon"></view>
                <text class="desktop-color-sheet-label-text">默认颜色</text>
              </view>
              <view :class="getColorRowClass()">
                <view @click="setTextColorAndClose('')" :class="getClearColorSwatchClass(data.formats.color == '')"></view>
                <view v-for="color in TEXT_COLOR_PRESETS" :key="color" @click="setTextColorAndClose(color)" :class="getFilledColorSwatchClass(data.formats.color == color)" :style="'background-color: ' + color + ';'"></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'background-color'">
            <view class="toolbar-color-section">
              <view class="desktop-color-sheet-label">
                <view class="desktop-color-sheet-icon"></view>
                <text class="desktop-color-sheet-label-text">默认背景</text>
              </view>
              <view :class="getColorRowClass()">
                <view @click="setBackgroundColorAndClose('')" :class="getClearColorSwatchClass(data.formats.backgroundColor == '')"></view>
                <view v-for="color in BACKGROUND_COLOR_PRESETS" :key="color" @click="setBackgroundColorAndClose(color)" :class="getFilledColorSwatchClass(data.formats.backgroundColor == color)" :style="'background-color: ' + color + ';'"></view>
              </view>
            </view>
          </view>

          <view class="toolbar-panel-section" v-if="data.activeSheet == 'more'">
            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">插入内容</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="toggleChecklistTool" :class="getDesktopMenuItemClass(data.formats.list == 'check')"><text :class="getDesktopMenuBadgeClass(data.formats.list == 'check')">TODO</text><text :class="getDesktopMenuTextClass(data.formats.list == 'check')">TODO</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="insertDivider" :class="getDesktopMenuItemClass(false)"><text :class="getDesktopMenuBadgeClass(false)">---</text><text :class="getDesktopMenuTextClass(false)">分割线</text></view></view>
              </view>
            </view>

            <view class="toolbar-panel-group">
              <text class="toolbar-color-title">编辑操作</text>
              <view :class="getToolbarChipRowClass()">
                <view :class="getToolbarChipCellClass()"><view @click="clearFormatting" :class="getDesktopMenuItemClass(false)"><text :class="getDesktopMenuBadgeClass(false)">CLR</text><text :class="getDesktopMenuTextClass(false)">清除样式</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="undo" :class="getDesktopMenuItemClass(false)"><text :class="getDesktopMenuBadgeClass(false)">↶</text><text :class="getDesktopMenuTextClass(false)">撤销</text></view></view>
                <view :class="getToolbarChipCellClass()"><view @click="redo" :class="getDesktopMenuItemClass(false)"><text :class="getDesktopMenuBadgeClass(false)">↷</text><text :class="getDesktopMenuTextClass(false)">重做</text></view></view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="editor-stage" :style="getEditorStageStyle()">
      <editor
        id="editor"
        class="editor-field"
        placeholder="请输入正文内容..."
        style="padding: 20px;"
        show-img-size
        show-img-toolbar
        show-img-resize
        @ready="onEditorReady"
        @focus="onEditorFocus"
        @blur="onEditorBlur"
        @statuschange="onStatusChange"
      />
    </view>
    </view>
  </view>
</template>

<script setup lang="uts">

type Formats = {
  bold: boolean;
  italic: boolean;
  underline: boolean;
  strike: boolean;
  // blockquote: boolean;
  header: number;
  list: string;
  align: string;
  textIndent: string;
  marginLeft: string;
  marginRight: string;
  lineHeight: string;
  letterSpacing: string;
  fontFamily: string;
  fontSize: string;
  color: string;
  backgroundColor: string;
}

const TEXT_COLOR_PRESETS: string[] = [
  '#000000', '#3f3f3f', '#6a6a6a', '#949494', '#bfbfbf', '#d8d8d8', '#ececec', '#f5f5f5', '#ffffff',
  '#f03a37', '#f26c2e', '#f59a33', '#f7d447', '#7bc943', '#59c3c3', '#4a90e2', '#3d5ed7', '#6f42c1', '#d13f96',
  '#f3ddd8', '#f7e8da', '#f7ecd3', '#fbf4d0', '#e5f1d4', '#d9eeea', '#d8eaf6', '#dbe3f4', '#e4ddf1', '#f1dde8',
  '#ff9d9a', '#ffb389', '#ffcf8a', '#fff17a', '#b8e986', '#7ed6d4', '#8cc8f6', '#9fb6f0', '#c3a5ea', '#f09ac5',
  '#ff4d57', '#ff7a45', '#ffad47', '#ffe44d', '#7edc3f', '#32c5c0', '#4aa8f0', '#5b7bea', '#9556d9', '#ec4fa3',
  '#d0021b', '#d9480f', '#df7b00', '#d9b300', '#38a000', '#1398a0', '#1769d2', '#2946c7', '#5b2db5', '#c2187a',
  '#98001a', '#952700', '#9a4b00', '#8a6a00', '#1f6f00', '#0d5c63', '#0d47a1', '#16269a', '#3c177c', '#8e105f'
]

const BACKGROUND_COLOR_PRESETS: string[] = [
  '#ffffff', '#e8e8e8', '#d9d9d9', '#c4c4c4', '#a8a8a8', '#8a8a8a', '#6d6d6d', '#4f4f4f', '#2f2f2f',
  '#fff1f0', '#fff4ec', '#fff7e8', '#fffbe6', '#f4fde8', '#edfdfb', '#eef7ff', '#f1f4ff', '#f5f0ff', '#fff0f7',
  '#ffd9d6', '#ffe3cf', '#ffecc8', '#fff5bf', '#e6f7c9', '#d8f3f2', '#d9ecff', '#dfe6ff', '#eadfff', '#ffd9ee',
  '#ffb8b5', '#ffc89f', '#ffd997', '#fff08a', '#d0f0a8', '#b8e9e7', '#b8dcff', '#c4d2ff', '#d9c2ff', '#ffb9de',
  '#ff8b87', '#ffa96f', '#ffc15f', '#ffe65c', '#a9e45f', '#86d9d5', '#8fc4ff', '#9eb5ff', '#c29af5', '#ff8cc8',
  '#ff5f5b', '#ff8a3d', '#ffaa2b', '#ffd400', '#7fd13b', '#42bebc', '#5da9ff', '#738ef5', '#9a68e0', '#ef5aae',
  '#ffdede', '#ffe9dd', '#fff1e0', '#fff7db', '#edf8df', '#e1f5f3', '#e3f0ff', '#e7ebff', '#efe8ff', '#ffe5f3'
]

type DataType = {
  toolbarVisible: boolean;
  toolbarBottom: number;
  keyboardHeight: number;
  pageWindowHeight: number;
  pageWindowWidth: number;
  tooltipVisible: boolean;
  tooltipText: string;
  tooltipLeft: number;
  tooltipTop: number;
  sheetHeight: number;
  sheetTop: number;
  sheetLeft: number;
  sheetArrowLeft: number;
  sheetAnimated: boolean;
  isFocused: boolean;
  ignoreNextBlur: boolean;
  toolbarKeepVisible: boolean;
  activeSheet: string;
  autoTest: boolean;
  editorReadyTest: boolean;
  undoTest: boolean;
  redoTest: boolean;
  removeFormatTest: boolean;
  insertImageTest: boolean;
  blurTest: boolean;
  clearTest: boolean;
  getContentDeltaTest: any | null;
  formatPainterActive: boolean;
  formatPainterFormats: Formats;
  formats: Formats;
}

const data = reactive<DataType>({
  toolbarVisible: false,
  toolbarBottom: 0,
  keyboardHeight: 0,
  pageWindowHeight: 0,
  pageWindowWidth: 0,
  tooltipVisible: false,
  tooltipText: '',
  tooltipLeft: 0,
  tooltipTop: 0,
  sheetHeight: 320,
  sheetTop: 74,
  sheetLeft: 12,
  sheetArrowLeft: 32,
  sheetAnimated: false,
  isFocused: false,
  ignoreNextBlur: false,
  toolbarKeepVisible: false,
  activeSheet: '',
  autoTest: false,
  editorReadyTest: false,
  undoTest: false,
  redoTest: false,
  removeFormatTest: false,
  insertImageTest: false,
  blurTest: false,
  clearTest: false,
  getContentDeltaTest: null,
  formatPainterActive: false,
  formatPainterFormats: {
    bold: false,
    italic: false,
    underline: false,
    strike: false,
    header: 0,
    list: '',
    align: '',
    textIndent: '',
    marginLeft: '',
    marginRight: '',
    lineHeight: '',
    letterSpacing: '',
    fontFamily: '',
    fontSize: '',
    color: '',
    backgroundColor: ''
  },
  formats: {
    bold: false,
    italic: false,
    underline: false,
    strike: false,
    // blockquote: false,
    header: 0,
    list: '',
    align: '',
    textIndent: '',
    marginLeft: '',
    marginRight: '',
    lineHeight: '',
    letterSpacing: '',
    fontFamily: '',
    fontSize: '',
    color: '',
    backgroundColor: ''
  }
})

const editorContext = ref<EditorContext | null>(null)

let keyboardChangeListenerId: number | null = null
let toolbarHideTimer = 0
let statusSyncLockedUntil = 0

function clearToolbarHideTimer() {
  if (toolbarHideTimer > 0) {
    clearTimeout(toolbarHideTimer)
    toolbarHideTimer = 0
  }
}

function scheduleToolbarHide() {
  clearToolbarHideTimer()
  toolbarHideTimer = setTimeout(() => {
    if (!data.isFocused && data.keyboardHeight <= 0 && data.activeSheet == '') {
      data.toolbarVisible = false
      data.toolbarBottom = 0
    }
    toolbarHideTimer = 0
  }, 120)
}

function getEditor() : EditorContext | null {
  return editorContext.value
}

function isWebToolbarMode() : boolean {
  // #ifdef WEB
  return true
  // #endif
  return false
}

function isToolbarRendered() : boolean {
  if (isWebToolbarMode()) {
    return true
  }
  return data.toolbarVisible
}

function getToolbarWrapStyle() : string {
  if (isWebToolbarMode()) {
    return ''
  }
  return `bottom:${data.toolbarBottom}px;`
}

function hasInlineStyleActive() : boolean {
  return data.formats.bold || data.formats.italic || data.formats.underline || data.formats.strike || data.formats.lineHeight != '' || data.formats.letterSpacing != '' || data.formats.fontSize != '' || data.formats.fontFamily != '' || data.formats.color != '' || data.formats.backgroundColor != ''
}

function getToolbarTooltipStyle() : string {
  return `left:${data.tooltipLeft}px;top:${data.tooltipTop}px;`
}

function isWideLayout() : boolean {
  return data.pageWindowWidth >= 1120
}


function syncToolbarBottom() {
  if (data.activeSheet != '') {
    data.toolbarBottom = data.sheetHeight
    return
  }
  data.toolbarBottom = data.keyboardHeight
}

function syncToolbarVisibility() {
  if (data.activeSheet != '') {
    data.toolbarVisible = true
    return
  }
  if (data.isFocused) {
    data.toolbarVisible = true
    return
  }
  if (data.keyboardHeight > 0) {
    data.toolbarVisible = true
    return
  }
  if (data.toolbarKeepVisible) {
    data.toolbarVisible = true
    return
  }
  data.toolbarVisible = false
}

function getPageShellClass() : string {
  if (isWideLayout()) {
    return 'page-shell page-shell-wide'
  }
  return 'page-shell'
}

function getEditorLayoutClass() : string {
  if (isWideLayout()) {
    return 'editor-layout editor-layout-wide'
  }
  return 'editor-layout'
}

function getSheetPanelStyle() : string {
  if (isWebToolbarMode()) {
    return ''
  }
  return `height:${data.sheetHeight}px;`
}

function getWebSheetWidth() : number {
  const windowWidth = data.pageWindowWidth > 0 ? data.pageWindowWidth : uni.getWindowInfo().windowWidth
  let maxWidth = windowWidth - 24
  if (maxWidth < 240) {
    maxWidth = windowWidth - 12
  }
  if (maxWidth < 220) {
    return maxWidth
  }
  if (data.activeSheet == 'title') {
    return maxWidth < 280 ? maxWidth : 280
  }
  if (data.activeSheet == 'style') {
    return maxWidth < 440 ? maxWidth : 440
  }
  if (data.activeSheet == 'text-color' || data.activeSheet == 'background-color') {
    return maxWidth < 372 ? maxWidth : 372
  }
  if (data.activeSheet == 'line-height' || data.activeSheet == 'letter-spacing') {
    return maxWidth < 220 ? maxWidth : 220
  }
  if (data.activeSheet == 'align') {
    return maxWidth < 220 ? maxWidth : 220
  }
  return maxWidth < 260 ? maxWidth : 260
}

function getSheetHostStyle() : string {
  if (!isWebToolbarMode()) {
    return ''
  }
  return `left:${data.sheetLeft}px;top:${data.sheetTop}px;width:${getWebSheetWidth()}px;`
}

function getToolbarPanelArrowStyle() : string {
  if (!isWebToolbarMode()) {
    return ''
  }
  return `left:${data.sheetArrowLeft}px;`
}

function getToolbarShellClass() : string {
  if (isWebToolbarMode()) {
    if (data.activeSheet != '') {
      return 'toolbar-shell toolbar-shell-attached toolbar-shell-web'
    }
    return 'toolbar-shell toolbar-shell-web'
  }
  if (data.activeSheet != '') {
    return 'toolbar-shell toolbar-shell-attached'
  }
  return 'toolbar-shell'
}

function isCompactWebToolbar() : boolean {
  if (!isWebToolbarMode()) {
    return false
  }
  const windowWidth = data.pageWindowWidth > 0 ? data.pageWindowWidth : uni.getWindowInfo().windowWidth
  return windowWidth < 1240
}

function isDenseWebToolbar() : boolean {
  if (!isWebToolbarMode()) {
    return false
  }
  const windowWidth = data.pageWindowWidth > 0 ? data.pageWindowWidth : uni.getWindowInfo().windowWidth
  return windowWidth < 980
}

function isStyleSheetHighlighted() : boolean {
  if (isWebToolbarMode()) {
    return data.activeSheet == 'style' || hasInlineStyleActive()
  }
  return data.activeSheet == 'style' || hasInlineStyleActive()
}
function getDesktopFontFamilyLabel() : string {
  if (data.formats.fontFamily == 'Microsoft YaHei') {
    return '雅黑'
  }
  if (data.formats.fontFamily == 'SimHei') {
    return '黑体'
  }
  if (data.formats.fontFamily == 'SimSun') {
    return '宋体'
  }
  if (data.formats.fontFamily == 'KaiTi') {
    return '楷体'
  }
  if (data.formats.fontFamily == 'FangSong') {
    return '仿宋'
  }
  if (data.formats.fontFamily == 'Georgia') {
    return 'Geo'
  }
  if (data.formats.fontFamily == 'Times New Roman') {
    return 'Times'
  }
  if (data.formats.fontFamily == 'Courier New') {
    return 'Mono'
  }
  return '字体'
}

function getDesktopToolbarShellClass() : string {
  let className = 'toolbar-web-shell'
  if (isCompactWebToolbar()) {
    className += ' toolbar-web-shell-compact'
  }
  if (isDenseWebToolbar()) {
    className += ' toolbar-web-shell-dense'
  }

  return className
}

function getDesktopToolbarGroupClass(isLeading: boolean) : string {
  let className = 'toolbar-web-group'
  if (isLeading) {
    className += ' toolbar-web-group-leading'
  }
  if (isCompactWebToolbar()) {
    className += ' toolbar-web-group-compact'
    if (isLeading) {
      className += ' toolbar-web-group-leading-compact'
    }
  }
  if (isDenseWebToolbar()) {
    className += ' toolbar-web-group-dense'
  }
  return className
}

function getDesktopToolbarDividerClass() : string {
  if (isCompactWebToolbar()) {
    return 'toolbar-web-divider toolbar-web-divider-hidden'
  }
  return 'toolbar-web-divider'
}

function getMobileStyleButtonClass() : string {
