}

.toolbar-web-shell-dense .toolbar-web-icon-text {
  font-size: 16px;
  line-height: 16px;
}

.toolbar-web-shell-dense .toolbar-web-select-font-label,
.toolbar-web-shell-dense .toolbar-web-select-label {
  font-size: 11px;
}


.toolbar-web-select-arrow {
