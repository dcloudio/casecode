    return 'toolbar-button toolbar-button-active toolbar-button-format-active'
  }
  return 'toolbar-button'
}

function getToolbarScrollTrackClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-scroll-track toolbar-scroll-track-web'
  }
  return 'toolbar-scroll-track'
}

function getToolbarRowClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-row toolbar-row-scroll toolbar-row-web'
  }
  return 'toolbar-row toolbar-row-scroll'
}

function getToolbarPanelClass() : string {
  if (isWebToolbarMode()) {
    if (data.sheetAnimated) {
      return 'toolbar-panel toolbar-panel-attached toolbar-panel-web toolbar-panel-web-attached toolbar-panel-web-entered'
    }
    return 'toolbar-panel toolbar-panel-attached toolbar-panel-web toolbar-panel-web-attached'
  }
  return 'toolbar-panel toolbar-panel-attached'
}

function getToolbarPanelHeaderClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-header toolbar-panel-header-web'
  }
  return 'toolbar-panel-header'
}

function getToolbarPanelTitleClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-title toolbar-panel-title-web'
  }
  return 'toolbar-panel-title'
}

function getToolbarPanelSubtitleClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-subtitle toolbar-panel-subtitle-web'
  }
  return 'toolbar-panel-subtitle'
}

function getToolbarPanelScrollClass() : string {
  if (isWebToolbarMode()) {
    return 'toolbar-panel-scroll toolbar-panel-scroll-web'
  }
  return 'toolbar-panel-scroll'
}

function getToolbarChipRowClass() : string {
  if (!isWebToolbarMode()) {
    return 'toolbar-chip-row'
  }
  const panelWidth = getWebSheetWidth()
  if (panelWidth <= 300) {
    return 'toolbar-chip-row toolbar-chip-row-web toolbar-chip-row-web-compact'
  }
  return 'toolbar-chip-row toolbar-chip-row-web'
}

function getToolbarChipCellClass() : string {
  if (!isWebToolbarMode()) {
    return 'toolbar-chip-cell'
  }
  if (data.activeSheet == 'title' || data.activeSheet == 'align' || data.activeSheet == 'more' || data.activeSheet == 'line-height' || data.activeSheet == 'letter-spacing' || data.activeSheet == 'font-size' || data.activeSheet == 'font-family' || data.activeSheet == 'block-indent' || data.activeSheet == 'list') {
    return 'toolbar-chip-cell toolbar-chip-cell-web toolbar-chip-cell-web-full'
  }
  if (data.activeSheet == 'style') {
    return 'toolbar-chip-cell toolbar-chip-cell-web toolbar-chip-cell-web-third'
  }
  return 'toolbar-chip-cell toolbar-chip-cell-web toolbar-chip-cell-web-quarter'
}

function getDesktopMenuItemClass(active: boolean) : string {
  if (!isWebToolbarMode()) {
    return active ? 'toolbar-chip toolbar-chip-grid toolbar-chip-active' : 'toolbar-chip toolbar-chip-grid'
  }
  return active ? 'desktop-menu-item desktop-menu-item-active' : 'desktop-menu-item'
}

function getDesktopMenuBadgeClass(active: boolean) : string {
  if (!isWebToolbarMode()) {
    return active ? 'toolbar-chip-badge toolbar-chip-badge-active' : 'toolbar-chip-badge'
  }
  return active ? 'desktop-menu-badge desktop-menu-badge-active' : 'desktop-menu-badge'
}

function getDesktopMenuTextClass(active: boolean) : string {
  if (!isWebToolbarMode()) {
    return active ? 'toolbar-chip-text toolbar-chip-text-active' : 'toolbar-chip-text'
  }
  return active ? 'desktop-menu-text desktop-menu-text-active' : 'desktop-menu-text'
}

function closeSheets() {
  if (isWebToolbarMode()) {
    data.sheetAnimated = false
    // #ifdef WEB
    hideToolbarTooltip()
    // #endif
  }
  data.activeSheet = ''
  syncToolbarBottom()
  syncToolbarVisibility()
}

function getColorRowClass() : string {
  if (!isWebToolbarMode()) {
    return 'color-row'
  }
  return 'color-row color-row-web'
}

function getClearColorSwatchClass(isActive: boolean) : string {
  let className = 'color-swatch'
  if (isWebToolbarMode()) {
    className += ' color-swatch-web'
  }
  className += ' color-swatch-clear'
  if (isActive) {
    className += ' color-swatch-active'
  }
  return className
}

function getFilledColorSwatchClass(isActive: boolean) : string {
