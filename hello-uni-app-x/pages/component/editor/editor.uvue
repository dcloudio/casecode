}

.toolbar-web-tooltip-bubble {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(15, 23, 42, 0.92);
  border-radius: 4px;
  padding-top: 5px;
  padding-right: 8px;
  padding-bottom: 5px;
  padding-left: 8px;
  box-shadow: 0px 8px 20px rgba(15, 23, 42, 0.18);
}

