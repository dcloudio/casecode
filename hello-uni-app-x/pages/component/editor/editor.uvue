  line-height: 14px;
}

.toolbar-web-tooltip-arrow {
  width: 8px;
  height: 8px;
  margin-bottom: -4px;
  background-color: rgba(15, 23, 42, 0.92);
  transform: rotate(45deg);
  border-radius: 1px;
}

.toolbar-web-select:hover,
.toolbar-web-icon-button:hover,
.toolbar-web-color-button:hover {
