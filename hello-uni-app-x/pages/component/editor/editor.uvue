}

.toolbar-web-color-button {
  height: 28px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-width: 1px;
  border-color: transparent;
  border-radius: 4px;
  background-color: transparent;
  margin-left: 1px;
