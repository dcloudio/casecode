  text-align: center;
}

.toolbar-web-select-label-active {
  color: #2b3137;
}

.toolbar-web-shell-dense .toolbar-web-select {
  padding-left: 4px;
  padding-right: 4px;
}

.toolbar-web-shell-dense .toolbar-web-select-value,
.toolbar-web-shell-dense .toolbar-web-select-compact {
