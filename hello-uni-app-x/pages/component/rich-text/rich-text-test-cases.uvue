<template>
	<!-- #ifdef APP -->
	<scroll-view style="flex: 1;">
	<!-- #endif -->
		<page-head title="rich-text 测试用例"></page-head>

		<view class="uni-padding-wrap">
			<!-- 测试类型选择器 -->
			<view class="selector-row">
				<text class="selector-label">测试类型:</text>
				<picker :range="groupNames" :value="currentGroupIndex" @change="onGroupChange">
					<view class="picker-value">
						<text class="picker-text">{{ currentGroupName }}</text>
					</view>
				</picker>
			</view>

			<!-- 测试用例选择器 -->
			<view class="selector-row">
				<text class="selector-label">测试用例:</text>
				<picker :range="caseNames" :value="currentCaseIndex" @change="onCaseChange">
					<view class="picker-value">
						<text class="picker-text">{{ currentCaseName }}</text>
					</view>
				</picker>
			</view>

			<!-- 导航按钮 -->
			<view class="nav-buttons">
				<button size="mini" @click="prevCase" :disabled="!canGoPrev">上一个</button>
				<text class="case-counter">{{ currentGlobalIndex + 1 }}/{{ totalCases }}</text>
				<button size="mini" @click="nextCase" :disabled="!canGoNext">下一个</button>
			</view>

			<!-- 用例信息 -->
			<view class="case-info">
				<text class="case-id">{{ currentCaseId }}: {{ currentCaseNameText }}</text>
				<text class="case-expected">预期: {{ currentExpected }}</text>
			</view>

			<!-- 渲染区域 -->
			<view class="render-area" id="render-container">
				<rich-text :nodes="currentHtml" style="background-color: #FFFFFF;" mode="native"></rich-text>
				<!-- <rich-text :nodes="currentHtml" style="background-color: #FFFFFF;" mode="web"></rich-text> -->
			</view>
		</view>

	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { TEST_GROUPS, getAllCaseIds, findCaseIndex, getTotalCaseCount } from './test-cases-data.uts'

	// 响应式数据
	const currentGroupIndex = ref<number>(0)
	const currentCaseIndex = ref<number>(0)
	const currentHtml = ref<string>('')
	const currentCaseId = ref<string>('')
	const currentCaseNameText = ref<string>('')
	const currentExpected = ref<string>('')

	// 计算属性：分组名称列表
	const groupNames = computed((): string[] => {
		const names: string[] = []
		for (let i = 0; i < TEST_GROUPS.length; i++) {
			names.push(TEST_GROUPS[i].name)
		}
		return names
	})

	// 计算属性：当前分组名称
	const currentGroupName = computed((): string => {
		if (currentGroupIndex.value < TEST_GROUPS.length) {
			return TEST_GROUPS[currentGroupIndex.value].name
		}
		return ''
	})

	// 计算属性：用例名称列表
	const caseNames = computed((): string[] => {
		const names: string[] = []
		if (currentGroupIndex.value < TEST_GROUPS.length) {
			const cases = TEST_GROUPS[currentGroupIndex.value].cases
			for (let i = 0; i < cases.length; i++) {
				const tc = cases[i]
				names.push(tc.id + ': ' + tc.name)
			}
		}
		return names
	})

	// 计算属性：当前用例名称
	const currentCaseName = computed((): string => {
		if (currentGroupIndex.value < TEST_GROUPS.length) {
			const cases = TEST_GROUPS[currentGroupIndex.value].cases
			if (currentCaseIndex.value < cases.length) {
				const tc = cases[currentCaseIndex.value]
				return tc.id + ': ' + tc.name
			}
		}
		return ''
	})

	// 计算属性：总用例数
	const totalCases = computed((): number => {
		return getTotalCaseCount()
	})

	// 计算属性：当前全局索引
	const currentGlobalIndex = computed((): number => {
		let index = 0
		for (let i = 0; i < currentGroupIndex.value; i++) {
			index += TEST_GROUPS[i].cases.length
		}
		return index + currentCaseIndex.value
	})

	// 计算属性：是否可以向前
	const canGoPrev = computed((): boolean => {
		return currentGlobalIndex.value > 0
	})

	// 计算属性：是否可以向后
	const canGoNext = computed((): boolean => {
		return currentGlobalIndex.value < totalCases.value - 1
	})

	// 加载当前用例
	function loadCurrentCase() {
		if (currentGroupIndex.value < TEST_GROUPS.length) {
			const cases = TEST_GROUPS[currentGroupIndex.value].cases
			if (currentCaseIndex.value < cases.length) {
				const tc = cases[currentCaseIndex.value]
				currentCaseId.value = tc.id
				currentCaseNameText.value = tc.name
				currentExpected.value = tc.expected
				currentHtml.value = tc.html
			}
		}
	}

	// 分组选择变化
	function onGroupChange(e: UniPickerChangeEvent) {
		currentGroupIndex.value = e.detail.value as number
		currentCaseIndex.value = 0
		loadCurrentCase()
	}

	// 用例选择变化
	function onCaseChange(e: UniPickerChangeEvent) {
		currentCaseIndex.value = e.detail.value as number
		loadCurrentCase()
	}

	// 下一个用例
	function nextCase(): boolean {
		if (currentGroupIndex.value < TEST_GROUPS.length) {
			const cases = TEST_GROUPS[currentGroupIndex.value].cases
			if (currentCaseIndex.value < cases.length - 1) {
				currentCaseIndex.value++
			} else if (currentGroupIndex.value < TEST_GROUPS.length - 1) {
				currentGroupIndex.value++
				currentCaseIndex.value = 0
			} else {
				return false
			}
			loadCurrentCase()
			return true
		}
		return false
	}

	// 上一个用例
	function prevCase(): boolean {
		if (currentCaseIndex.value > 0) {
			currentCaseIndex.value--
		} else if (currentGroupIndex.value > 0) {
			currentGroupIndex.value--
			currentCaseIndex.value = TEST_GROUPS[currentGroupIndex.value].cases.length - 1
		} else {
			return false
		}
		loadCurrentCase()
		return true
	}

	// 供测试文件调用：根据ID加载用例
	function loadCase(caseId: string): boolean {
		const indices = findCaseIndex(caseId)
		if (indices[0] >= 0) {
			currentGroupIndex.value = indices[0]
			currentCaseIndex.value = indices[1]
			loadCurrentCase()
			return true
		}
		return false
	}

	// 供测试文件调用：获取所有用例ID
	function getCaseIds(): string[] {
		return getAllCaseIds()
	}

	// 供测试文件调用：获取当前用例ID
	function getCurrentCaseId(): string {
		return currentCaseId.value
	}

	// 页面初始化
	onReady(() => {
    console.log("jinlailema")
		loadCurrentCase()
	})

	// 暴露给测试和外部调用
	defineExpose({
		loadCase,
		nextCase,
		prevCase,
		getCaseIds,
		getCurrentCaseId
	})
</script>

<style>
	.selector-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 10px 0;
	}

	.selector-label {
		width: 80px;
		font-size: 14px;
	}

	.picker-value {
		flex: 1;
		padding: 8px 12px;
		background-color: #f5f5f5;
		border-radius: 4px;
	}

	.picker-text {
		font-size: 14px;
	}

	.nav-buttons {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		margin: 15px 0;
	}

	.case-counter {
		margin: 0 20px;
		font-size: 14px;
		color: #666666;
	}

	.case-info {
		display: flex;
		flex-direction: column;
		padding: 10px;
		background-color: #f0f0f0;
		border-radius: 4px;
		margin-bottom: 15px;
	}

	.case-id {
		font-size: 16px;
		font-weight: bold;
		color: #333333;
	}

	.case-expected {
		font-size: 12px;
		color: #666666;
		margin-top: 5px;
	}

	.render-area {
		min-height: 200px;
		padding: 15px;
		background-color: #ffffff;
		border-width: 1px;
		border-style: solid;
		border-color: #e0e0e0;
		border-radius: 4px;
	}
</style>
