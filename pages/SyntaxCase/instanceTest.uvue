<template>
  <text>{{ret}}</text>
	<button @click="instanceCreate">多实例创建测试</button>
	
</template>

<script setup lang="uts">
import { User } from '@/uni_modules/uts-advance'

const ret = ref('')
// 将uts的class实例放进data里，测试响应式包装后是否有问题
const user1 = ref(new User("张三", 20))

function instanceCreate() {
  const user2 = new User("李四", 30)
  const user3 = new User("王五", 40)

  const userText1 = user1.value.describeSelf()
  const userText2 = user2.describeSelf()
  const userText3 = user3.describeSelf()

  if (userText1 == userText2 || userText1 == userText3 || userText2 == userText3) {
    ret.value = '测试未通过'
  } else {
    ret.value = '测试通过'
  }
}
</script>

