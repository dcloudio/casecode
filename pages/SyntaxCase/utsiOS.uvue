<template>
  <!-- #ifdef APP-IOS -->
  <!-- #ifdef APP -->
  <scroll-view style="flex: 1">
    <!-- #endif -->
  	<button @click="testCurrentVC">获取当前UIViewController</button>
  	<view class="result" :style="resultStyle(currentVCResult.passed)"> 测试结果 -- {{formatResult(currentVCResult.passed)}}</view>
  	<button @click="testKeyWindow">获取当前app的keyWindow</button>
  	<view class="result" :style="resultStyle(keyWindowResult.passed)"> 测试结果 -- {{formatResult(keyWindowResult.passed)}}</view>
  	<button @click="testColorConvert">将字符串色值转换为UIColor</button>
  	<view class="result">
  		<text v-for="item in colorConvertResult" :style="resultStyle(item.passed)"> {{item.key}}: {{item.value}} -- {{formatResult(item.passed)}}</text>
  	</view>
  	<button @click="testResourcePath">资源路径转换</button>
  	<view class="result" :style="resultStyle(resourcePathResult.passed)"> {{resourcePathResult.key}}: {{resourcePathResult.value}} -- {{formatResult(resourcePathResult.passed)}}</view>
  	<button @click="testDeviceInfo">获取设备信息</button>
  	<view class="result">
  		<text v-for="item in deviceInfoResult" :style="resultStyle(item.passed)"> {{item.key}}: {{item.value}} -- {{formatResult(item.passed)}}</text>
  	</view>
  	<button @click="testAppInfo">获取App信息相关api</button>
  	<view class="result">
  		<text v-for="item in appInfoResult" :style="resultStyle(item.passed)"> {{item.key}}: {{item.value}} -- {{formatResult(item.passed)}}</text>
  	</view>
  	<button @click="testSystemSetting">获取系统设置</button>
  	<view class="result" :style="resultStyle(systemSettingResult.passed)"> {{systemSettingResult.key}}: {{systemSettingResult.value}} -- {{formatResult(systemSettingResult.passed)}}</view>
  	<button @click="testTypeof">typeof</button>
  	<view class="result">
  		<text v-for="item in typeofResult" :style="resultStyle(item.passed)"> {{item.key}}: {{item.value}} -- {{formatResult(item.passed)}}</text>
  	</view>
  	<button @click="testDataConvert">数据转换</button>
  	<view class="result">
  		<text v-for="item in dataConvertResult" :style="resultStyle(item.passed)"> {{item.key}}: {{item.value}} -- {{formatResult(item.passed)}}</text>
  	</view>
  	<button @click="testAll">test all</button>
    <button @click="a2b">atob测试</button>
    <button @click="b2a">btoa测试</button>
    <!-- #ifdef APP -->
  </scroll-view>
  <!-- #endif -->
  <!-- #endif -->
</template>

<script setup lang="uts">
// #ifdef APP-IOS
import {
  getCurrentVCTest,
  getKeyWindowTest,
  colorWithStringTest,
  getResourcePathTest,
  getDeviceInfoTest,
  getAppInfoTest,
  getSystemSettingTest,
  tepeofTest,
  dataConvertTest,
} from "@/uni_modules/uts-platform-api"

const title = "UTSiOS test"
const currentVCResult = ref({} as UTSJSONObject)
const keyWindowResult = ref({} as UTSJSONObject)
const colorConvertResult = ref([] as UTSJSONObject[])
const resourcePathResult = ref({} as UTSJSONObject)
const deviceInfoResult = ref([] as UTSJSONObject[])
const appInfoResult = ref([] as UTSJSONObject[])
const systemSettingResult = ref({} as UTSJSONObject)
const typeofResult = ref([] as UTSJSONObject[])
const dataConvertResult = ref([] as UTSJSONObject[])

	function a2b() {
	  const r1 = atob("aGVsbG8gd29ybGQ=")
	  console.log("atob(\"aGVsbG8gd29ybGQ=\") 测试 ===>" , r1, r1 == 'hello world')
	  
	  const str1 = ""
	  const str2 = '@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM'
	  const r2 = atob(str1)
	  console.log(`atob(${str1}) 测试 ====>`, r2, r2 == str2)
	}
	
	function b2a() {
		const r1 = btoa("hello world")
		console.log("btoa(\"hello world\") 测试 ===>" , r1, r1 == 'aGVsbG8gd29ybGQ=')
		
		const str1 = "@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM@-1234567890qwertyuiopasdfghjklzxcvbnm-QWERTYUIOPASDFGHJKLZXCVBNM"
		const str2 = ''
		const r2 = btoa(str1)
		console.log(`btoa(${str1}) 测试 ====>`, r2, r2 == str2)
	}

function formatResult(res: any) {
  if (res == null) {
    return ""
  }
  return res ? "测试通过" : "测试失败"
}

function resultStyle(res: any) {
  if (res == null) {
    return {
      color: "#333333"
    }
  }
  const color = res ? "#00ff00" : "#ff0000"
  return {
    color: color
  }
}

function testCurrentVC() {
  currentVCResult.value = getCurrentVCTest()
}

function testKeyWindow() {
  keyWindowResult.value = getKeyWindowTest()
}

function testColorConvert() {
  const array = colorWithStringTest()
  colorConvertResult.value = array.map((value) => {
    return JSON.parse(value)
  })
}

function testResourcePath() {
  resourcePathResult.value = getResourcePathTest("/static/logo.png")
}

function testDeviceInfo() {
  const array = getDeviceInfoTest()
  deviceInfoResult.value = array.map((value) => {
    return JSON.parse(value)
  })
}

function testAppInfo() {
  const array = getAppInfoTest()
  appInfoResult.value = array.map((value) => {
    return JSON.parse(value)
  })
}

function testSystemSetting() {
  systemSettingResult.value = getSystemSettingTest()
}

function testTypeof() {
  const array = tepeofTest()
  typeofResult.value = array.map((value) => {
    return JSON.parse(value)
  })
}

function testDataConvert() {
  const array = dataConvertTest()
  dataConvertResult.value = array.map((value) => {
    return JSON.parse(value)
  })
}

function testAll() {
  testCurrentVC()
  testKeyWindow()
  testColorConvert()
  testResourcePath()
  testDeviceInfo()
  testAppInfo()
  testSystemSetting()
  testTypeof()
  testDataConvert()
}

// #endif

</script>

<style>
  
  .result {
  	text-align: left;
  	padding-left: 20px;
  	padding-right: 20px;
  	max-width: 750rpx;
  	overflow: visible;
  }
</style>