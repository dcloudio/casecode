<template>
  <view>
    <view id="longPressView" style="width: 100%;height: 200px;background-color: aquamarine;" @longpress="onLongPress">
    </view>
  </view>
</template>

<script setup>
  type DataType = {
    isLongPressTrigger : boolean,
    eventDomRect : DOMRect | null
  }

  const data = { isLongPressTrigger: false, eventDomRect: null as DOMRect | null } as DataType

  onReady(() => {
    let element = uni.getElementById("longPressView")
    data.eventDomRect = element?.getBoundingClientRect();
  })
  function onLongPress() {
    data.isLongPressTrigger = true
  }
  defineExpose({
    data
  })
</script>

<style>

</style>
