			{ id: 'P2-01', name: '无序列表', html: '<ul><li>Item A</li><li>Item B</li><li>Item C</li></ul>', expected: '显示列表符号' },
			{ id: 'P2-02', name: '嵌套列表', html: '<ul><li>Level 1<ul><li>Level 2-A</li><li>Level 2-B</li></ul></li></ul>', expected: '二级缩进' },
			{ id: 'P2-03', name: '基础表格', html: '<table><tr><td>Cell A</td><td>Cell B</td></tr></table>', expected: '两列显示' },
			{ id: 'P2-04', name: '表头th', html: '<table><tr><th>Header</th></tr><tr><td>Data</td></tr></table>', expected: '表头加粗' },
			{ id: 'P2-05', name: '多行表格', html: '<table><tr><td>1-1</td><td>1-2</td><td>1-3</td></tr><tr><td>2-1</td><td>2-2</td><td>2-3</td></tr><tr><td>3-1</td><td>3-2</td><td>3-3</td></tr></table>', expected: '正确布局' },
			{ id: 'P2-06', name: '链接a', html: '<p><a href="http://example.com">Link Text</a></p>', expected: '链接颜色+可点击' },
			{ id: 'P2-07', name: '图片img基础', html: '<p><img src="' + TEST_IMAGE_URL + '" width="100" height="100"></p>', expected: '显示图片' },
