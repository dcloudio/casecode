/**
 * rich-text 测试用例数据
 *
 * 测试分类：
 * - P0: 核心解析功能
 * - P1: 基础文本元素
 * - P2: 复杂结构元素
 * - P3: CSS样式解析
 * - P4: 边界与异常
 * - P5: 图片测试（网络图片）
 * - P6: 不支持的HTML标签
 * - P7: 不支持的CSS
 */

// ========== 类型定义 ==========
export type TestCase = {
	id : string;       // 用例ID，如 "P0-01"
	name : string;     // 用例名称
	html : string;     // HTML 内容
	expected : string; // 预期结果描述
}

export type TestGroup = {
	id : string;       // 分组ID，如 "P0"
	name : string;     // 分组名称
	cases : TestCase[];
}

// 网络测试图片
const TEST_IMAGE_URL = 'https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni@2x.png'
const TEST_IMAGE_SMALL = 'https://qiniu-web-assets.dcloud.net.cn/unidoc/zh/uni-app-x/component/button/mix-button-mini.png'

// ========== 测试数据 ==========
