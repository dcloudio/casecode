			{ id: 'P6-02', name: 'span', html: '<p><span>span text</span></p>', expected: '文本正常显示' },
			{ id: 'P6-03', name: 'script标签', html: '<script>script tag</script><p>safe</p>', expected: '必须忽略，不执行' },
