			{ id: 'P7-02', name: 'border', html: '<p style="border:1px solid red">border text</p>', expected: '可能无边框' },
			{ id: 'P7-03', name: 'display none', html: '<p style="display:none">hidden</p><p>visible</p>', expected: '可能仍显示' },
