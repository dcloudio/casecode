			{ id: 'P5-09', name: '图片在div中', html: '<div style="background:#eee;padding:10px"><img src="' + TEST_IMAGE_URL + '" width="60"></div>', expected: '图片在灰色背景div中' },
			{ id: 'P5-10', name: '图片链接', html: '<a href="http://example.com"><img src="' + TEST_IMAGE_URL + '" width="50"></a>', expected: '可点击的图片链接' },
		] as TestCase[]
	} as TestGroup,

	// P6 - 不支持的HTML标签
	{
