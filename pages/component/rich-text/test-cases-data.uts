			{ id: 'P0-05', name: '自闭标签img', html: '<p><img src="' + TEST_IMAGE_SMALL + '" width="50">text</p>', expected: '图片+文本' },
			{ id: 'P0-06', name: '自闭标签hr', html: '<p>above</p><hr><p>below</p>', expected: '显示水平线' },
		] as TestCase[]
	} as TestGroup,

	// P1 - 基础文本元素
	{
		id: 'P1',
		name: 'P1 - 基础文本元素',
		cases: [
			{ id: 'P1-01', name: '加粗 b', html: '<p><b>bold text</b></p>', expected: '粗体显示' },
			{ id: 'P1-02', name: '加粗 strong', html: '<p><strong>bold text</strong></p>', expected: '粗体显示' },
			{ id: 'P1-03', name: '斜体 i', html: '<p><i>italic text</i></p>', expected: '斜体显示' },
			{ id: 'P1-04', name: '斜体 em', html: '<p><em>italic text</em></p>', expected: '斜体显示' },
			{ id: 'P1-05', name: '下划线 u', html: '<p><u>underline text</u></p>', expected: '显示下划线' },
			{ id: 'P1-06', name: '删除线 del', html: '<p><del>deleted text</del></p>', expected: '显示删除线' },
			{ id: 'P1-07', name: '删除线 s', html: '<p><s>strike text</s></p>', expected: '显示删除线' },
			{ id: 'P1-08', name: '嵌套格式', html: '<p><b><i>bold and italic</i></b></p>', expected: '粗斜体显示' },
			{ id: 'P1-09', name: '标题h1-h6', html: '<h1>H1</h1><h2>H2</h2><h3>H3</h3><h4>H4</h4><h5>H5</h5><h6>H6</h6>', expected: 'H1最大，H6最小' },
			{ id: 'P1-10', name: '代码 code', html: '<p><code>code text</code></p>', expected: '等宽字体' },
			{ id: 'P1-11', name: '大字 big', html: '<p><big>bigger text</big></p>', expected: '字号增大' },
			{ id: 'P1-12', name: '小字 small', html: '<p><small>smaller text</small></p>', expected: '字号减小' },
