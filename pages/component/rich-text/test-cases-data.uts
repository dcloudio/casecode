// ========== 辅助函数 ==========

/**
 * 获取所有用例ID列表
 */
export function getAllCaseIds() : string[] {
	const ids : string[] = []
	for (let i = 0; i < TEST_GROUPS.length; i++) {
		const group = TEST_GROUPS[i]
		for (let j = 0; j < group.cases.length; j++) {
			ids.push(group.cases[j].id)
		}
	}
	return ids
}

/**
 * 根据ID查找用例
 */
export function findCaseById(caseId : string) : TestCase | null {
	for (let i = 0; i < TEST_GROUPS.length; i++) {
		const group = TEST_GROUPS[i]
		for (let j = 0; j < group.cases.length; j++) {
			if (group.cases[j].id == caseId) {
				return group.cases[j]
			}
		}
	}
	return null
}

/**
 * 获取用例的组索引和用例索引
 * 返回 [groupIndex, caseIndex]，未找到返回 [-1, -1]
 */
export function findCaseIndex(caseId : string) : number[] {
	for (let gi = 0; gi < TEST_GROUPS.length; gi++) {
		const group = TEST_GROUPS[gi]
		for (let ci = 0; ci < group.cases.length; ci++) {
			if (group.cases[ci].id == caseId) {
				return [gi, ci]
			}
		}
	}
	return [-1, -1]
}

/**
 * 获取总用例数量
 */
export function getTotalCaseCount() : number {
	let count = 0
	for (let i = 0; i < TEST_GROUPS.length; i++) {
		count += TEST_GROUPS[i].cases.length
	}
	return count
}
